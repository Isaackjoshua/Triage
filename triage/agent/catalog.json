{
  "version": 1,
  "notes": [
    "The classified command catalog. This is DATA, not logic: the gate reads it, the",
    "operator can audit it, and extending the read surface is a JSON edit rather than a",
    "code change. Resolution order per entry is defined in triage/agent/catalog.py.",
    "",
    "classification    default verdict for the binary when no subcommand rule matches",
    "bare_classification  verdict when invoked with no arguments at all",
    "read_subcommands  first positional must be one of these to be READ",
    "write_subcommands any of the first two positionals matching forces WRITE",
    "read_flags        flag-only invocations are READ if one of these is present",
    "write_flags       any occurrence forces WRITE (the flag mutates state)",
    "blocked_flags     refused as UNKNOWN for non-mutation reasons (e.g. never returns)",
    "write_if_assignment  a NAME=VALUE argument forces WRITE"
  ],
  "commands": [
    {
      "name": "smartctl",
      "classification": "READ",
      "requires_sudo": true,
      "summary": "SMART health and attributes for a disk.",
      "write_flags": ["-t", "--test", "-X", "--abort", "-s", "--smart", "-S", "--saveauto", "-o", "--offlineauto", "-C", "--captive", "--set"],
      "note": "-a/-H/-x/-i are read-only. -t starts a self-test, which is a side effect."
    },
    {
      "name": "nvme",
      "classification": "WRITE",
      "requires_sudo": true,
      "summary": "NVMe controller and namespace information.",
      "read_subcommands": ["list", "smart-log", "id-ctrl", "id-ns", "error-log", "fw-log", "list-ns", "show-regs", "get-feature", "self-test-log"],
      "write_subcommands": ["format", "sanitize", "delete-ns", "create-ns", "attach-ns", "detach-ns", "set-feature", "reset", "write", "write-zeroes", "dsm", "device-self-test", "fw-download", "fw-commit"]
    },
    {
      "name": "sensors",
      "classification": "READ",
      "summary": "Temperature, voltage, and fan readings from lm-sensors.",
      "write_flags": ["-s", "--set"]
    },
    {
      "name": "journalctl",
      "classification": "READ",
      "requires_sudo": true,
      "summary": "systemd journal. Use -p err -b for this boot's errors.",
      "blocked_flags": ["-f", "--follow"],
      "write_flags": ["--vacuum-size", "--vacuum-time", "--vacuum-files", "--rotate", "--flush", "--sync", "--relinquish-var", "--setup-keys"],
      "note": "--follow never returns; it is refused rather than left to the timeout."
    },
    {
      "name": "dmesg",
      "classification": "READ",
      "requires_sudo": true,
      "summary": "Kernel ring buffer. -T -l err,crit for human timestamps and severity.",
      "blocked_flags": ["-w", "--follow", "-W", "--follow-new"],
      "write_flags": ["-C", "--clear", "-c", "--read-clear", "-n", "--console-level", "-D", "--console-off", "-E", "--console-on"]
    },
    {
      "name": "systemctl",
      "classification": "WRITE",
      "bare_classification": "READ",
      "summary": "systemd unit state. --failed is the fastest way to see what is broken.",
      "read_subcommands": ["status", "show", "cat", "list-units", "list-unit-files", "list-sockets", "list-timers", "list-jobs", "list-machines", "list-dependencies", "is-active", "is-enabled", "is-failed", "is-system-running", "get-default", "show-environment"],
      "read_flags": ["--failed", "--version", "--type", "--all", "-a"]
    },
    {
      "name": "systemd-analyze",
      "classification": "READ",
      "summary": "Boot timing and unit verification.",
      "write_flags": ["set-log-level", "set-log-target", "service-watchdogs"]
    },
    {
      "name": "loginctl",
      "classification": "WRITE",
      "bare_classification": "READ",
      "summary": "Login session state.",
      "read_subcommands": ["list-sessions", "session-status", "show-session", "list-users", "user-status", "show-user", "list-seats", "seat-status", "show-seat"]
    },
    {
      "name": "hostnamectl",
      "classification": "WRITE",
      "bare_classification": "READ",
      "summary": "Hostname, machine ID, kernel, and hardware vendor/model.",
      "read_subcommands": ["status"]
    },
    {
      "name": "timedatectl",
      "classification": "WRITE",
      "bare_classification": "READ",
      "summary": "Clock, timezone, and NTP sync state.",
      "read_subcommands": ["status", "show", "list-timezones", "timesync-status", "show-timesync"]
    },
    {
      "name": "df",
      "classification": "READ",
      "summary": "Filesystem usage. -h for human sizes, -i for inode exhaustion."
    },
    { "name": "du", "classification": "READ", "summary": "Directory sizes." },
    { "name": "free", "classification": "READ", "summary": "Memory and swap usage." },
    { "name": "vmstat", "classification": "READ", "summary": "Virtual memory and IO statistics." },
    { "name": "iostat", "classification": "READ", "summary": "Per-device IO statistics." },
    { "name": "mpstat", "classification": "READ", "summary": "Per-CPU utilisation." },
    { "name": "uptime", "classification": "READ", "summary": "Uptime and load average." },
    { "name": "lsblk", "classification": "READ", "summary": "Block device tree." },
    { "name": "blkid", "classification": "READ", "requires_sudo": true, "summary": "Block device UUIDs and filesystem types.", "write_flags": ["-g", "--garbage-collect"] },
    { "name": "findmnt", "classification": "READ", "summary": "Mount table, resolved. Safer than parsing /etc/fstab by hand.", "blocked_flags": ["-p", "--poll"] },
    { "name": "lscpu", "classification": "READ", "summary": "CPU topology and flags." },
    { "name": "lsmem", "classification": "READ", "summary": "Memory block layout." },
    { "name": "lspci", "classification": "READ", "summary": "PCI devices. -k shows the bound kernel driver." },
    { "name": "lsusb", "classification": "READ", "summary": "USB devices." },
    { "name": "lsmod", "classification": "READ", "summary": "Loaded kernel modules." },
    { "name": "modinfo", "classification": "READ", "summary": "Kernel module metadata." },
    { "name": "lsattr", "classification": "READ", "summary": "Filesystem attributes on files." },
    { "name": "lsof", "classification": "READ", "requires_sudo": true, "summary": "Open files and sockets.", "blocked_flags": ["-r", "+r"] },
    { "name": "ps", "classification": "READ", "summary": "Process table snapshot. Prefer this over interactive top." },
    { "name": "pidof", "classification": "READ", "summary": "PID for a named process." },
    { "name": "uname", "classification": "READ", "summary": "Kernel name and release." },
    { "name": "id", "classification": "READ", "summary": "Effective user and groups." },
    { "name": "whoami", "classification": "READ", "summary": "Effective username." },
    { "name": "date", "classification": "WRITE", "bare_classification": "READ", "summary": "System clock. Setting the clock is a write.", "read_flags": ["-u", "--utc", "-R", "--rfc-2822", "-I", "--iso-8601", "+%s"], "write_flags": ["-s", "--set"] },
    { "name": "hostname", "classification": "WRITE", "bare_classification": "READ", "summary": "Hostname. With an argument it sets it.", "read_flags": ["-f", "--fqdn", "-i", "-I", "--all-ip-addresses"] },
    { "name": "lsb_release", "classification": "READ", "summary": "Distribution release information." },
    {
      "name": "dmidecode",
      "classification": "READ",
      "requires_sudo": true,
      "summary": "SMBIOS/DMI tables: board, BIOS, memory module inventory.",
      "note": "The single best source for RAM slot population and BIOS version."
    },
    {
      "name": "ip",
      "classification": "WRITE",
      "summary": "Network addresses, links, and routes.",
      "read_subcommands": ["a", "addr", "address", "l", "link", "r", "route", "n", "neigh", "neighbour", "rule", "maddr", "mroute", "tunnel", "netns"],
      "write_subcommands": ["set", "add", "del", "delete", "change", "replace", "flush", "append", "prepend", "up", "down"]
    },
    { "name": "ss", "classification": "READ", "summary": "Socket statistics. Replaces netstat.", "write_flags": ["-K", "--kill"] },
    { "name": "netstat", "classification": "READ", "summary": "Network connections (legacy; prefer ss).", "blocked_flags": ["-c", "--continuous"] },
    { "name": "ping", "classification": "READ", "summary": "Reachability check. Always bound it with -c.", "blocked_flags": ["-f", "--flood"], "note": "Sends packets but mutates nothing on the target. Use -c so it terminates." },
    { "name": "resolvectl", "classification": "WRITE", "bare_classification": "READ", "summary": "DNS resolver state.", "read_subcommands": ["status", "query", "statistics", "dns", "domain", "show-cache"], "write_subcommands": ["flush-caches", "reset-statistics", "revert", "set-dns", "set-domain"] },
    { "name": "getenforce", "classification": "READ", "summary": "SELinux enforcement mode." },
    { "name": "sestatus", "classification": "READ", "summary": "SELinux status detail." },
    { "name": "aa-status", "classification": "READ", "requires_sudo": true, "summary": "AppArmor profile status." },
    {
      "name": "sysctl",
      "classification": "READ",
      "requires_sudo": true,
      "summary": "Kernel parameters. Reading is safe; setting one is a write.",
      "write_flags": ["-w", "--write", "-p", "--load", "--system"],
      "write_if_assignment": true
    },
    {
      "name": "fdisk",
      "classification": "WRITE",
      "requires_sudo": true,
      "summary": "Partition tables. Only the listing form is a read.",
      "read_flags": ["-l", "--list", "-L", "--list-details"]
    },
    { "name": "parted", "classification": "WRITE", "requires_sudo": true, "summary": "Partition tables. Only -l is a read.", "read_flags": ["-l", "--list"] },
    { "name": "pvs", "classification": "READ", "requires_sudo": true, "summary": "LVM physical volumes." },
    { "name": "vgs", "classification": "READ", "requires_sudo": true, "summary": "LVM volume groups." },
    { "name": "lvs", "classification": "READ", "requires_sudo": true, "summary": "LVM logical volumes." },
    { "name": "pvdisplay", "classification": "READ", "requires_sudo": true, "summary": "LVM physical volume detail." },
    { "name": "vgdisplay", "classification": "READ", "requires_sudo": true, "summary": "LVM volume group detail." },
    { "name": "lvdisplay", "classification": "READ", "requires_sudo": true, "summary": "LVM logical volume detail." },
    {
      "name": "btrfs",
      "classification": "WRITE",
      "requires_sudo": true,
      "summary": "btrfs filesystem and subvolume inspection.",
      "read_subcommands": ["filesystem", "subvolume", "device", "scrub", "inspect-internal", "qgroup", "property"],
      "write_subcommands": ["create", "delete", "destroy", "snapshot", "balance", "resize", "replace", "add", "remove", "start", "cancel", "label", "defragment", "set", "sync", "resume"]
    },
    {
      "name": "zfs",
      "classification": "WRITE",
      "requires_sudo": true,
      "summary": "ZFS dataset inspection.",
      "read_subcommands": ["list", "get", "holds", "version"],
      "write_subcommands": ["create", "destroy", "snapshot", "rollback", "set", "inherit", "rename", "clone", "promote", "send", "receive", "mount", "unmount", "share", "unshare", "allow", "unallow"]
    },
    {
      "name": "zpool",
      "classification": "WRITE",
      "requires_sudo": true,
      "summary": "ZFS pool health. `zpool status -v` is the first thing to read on a ZFS box.",
      "read_subcommands": ["status", "list", "get", "history", "iostat", "events", "version"],
      "write_subcommands": ["create", "destroy", "add", "remove", "replace", "attach", "detach", "scrub", "resilver", "clear", "import", "export", "set", "offline", "online", "trim", "initialize", "upgrade", "split", "labelclear"]
    },
    { "name": "mdadm", "classification": "WRITE", "requires_sudo": true, "summary": "Software RAID. Only the detail/examine/query forms are reads.", "read_flags": ["-D", "--detail", "-E", "--examine", "-Q", "--query", "--detail-platform"] },
    {
      "name": "dpkg",
      "classification": "WRITE",
      "summary": "Debian package database queries.",
      "read_flags": ["-l", "--list", "-s", "--status", "-L", "--listfiles", "-S", "--search", "-V", "--verify", "-p", "--print-avail"],
      "write_flags": ["-i", "--install", "-r", "--remove", "-P", "--purge", "--unpack", "--configure", "--force-all"]
    },
    { "name": "dpkg-query", "classification": "READ", "summary": "Debian package database queries (query-only binary)." },
    { "name": "apt-cache", "classification": "READ", "summary": "APT package cache queries." },
    {
      "name": "apt",
      "classification": "WRITE",
      "summary": "APT. Only the query subcommands are reads.",
      "read_subcommands": ["list", "show", "search", "depends", "rdepends", "policy", "showsrc"],
      "write_subcommands": ["install", "remove", "purge", "upgrade", "full-upgrade", "dist-upgrade", "autoremove", "update", "clean", "autoclean", "reinstall"]
    },
    {
      "name": "apt-get",
      "classification": "WRITE",
      "summary": "APT (scripted interface). Only --dry-run style queries are reads.",
      "read_flags": ["-s", "--simulate", "--dry-run", "--just-print", "--no-act"]
    },
    {
      "name": "rpm",
      "classification": "WRITE",
      "summary": "RPM database queries.",
      "read_flags": ["-q", "-qa", "-qi", "-ql", "-qf", "--query", "--queryformat", "-V", "--verify"],
      "write_flags": ["-i", "--install", "-U", "--upgrade", "-e", "--erase", "-F", "--freshen", "--rebuilddb"]
    },
    {
      "name": "dnf",
      "classification": "WRITE",
      "summary": "DNF. Only the query subcommands are reads.",
      "read_subcommands": ["list", "info", "search", "repoquery", "repolist", "history", "check-update", "provides", "deplist"],
      "write_subcommands": ["install", "remove", "erase", "upgrade", "update", "downgrade", "reinstall", "autoremove", "clean", "makecache", "distro-sync"]
    },
    {
      "name": "yum",
      "classification": "WRITE",
      "summary": "YUM. Only the query subcommands are reads.",
      "read_subcommands": ["list", "info", "search", "repolist", "history", "check-update", "provides", "deplist"],
      "write_subcommands": ["install", "remove", "erase", "upgrade", "update", "downgrade", "reinstall", "clean", "makecache"]
    },
    {
      "name": "pacman",
      "classification": "WRITE",
      "summary": "Pacman. Only the -Q/-S...s query forms are reads.",
      "read_flags": ["-Q", "-Qi", "-Ql", "-Qe", "-Qm", "-Qdt", "-Si", "-Ss", "-Sl"],
      "write_flags": ["-S", "-R", "-U", "-Sy", "-Syu", "-Rns", "-Scc", "-Sc"]
    },
    {
      "name": "cat",
      "classification": "READ",
      "summary": "Read a specific file — logs, /proc entries, config files.",
      "note": "Redirection is rejected before this entry is ever consulted, so cat cannot write."
    },
    { "name": "head", "classification": "READ", "summary": "First lines of a file." },
    { "name": "tail", "classification": "READ", "summary": "Last lines of a file.", "blocked_flags": ["-f", "--follow", "-F"] },
    { "name": "grep", "classification": "READ", "summary": "Search file contents." },
    { "name": "egrep", "classification": "READ", "summary": "Search file contents (extended regex)." },
    { "name": "zgrep", "classification": "READ", "summary": "Search compressed file contents." },
    { "name": "zcat", "classification": "READ", "summary": "Read compressed files — rotated logs." },
    { "name": "wc", "classification": "READ", "summary": "Count lines, words, bytes." },
    { "name": "sort", "classification": "READ", "summary": "Sort lines.", "write_flags": ["-o", "--output"] },
    { "name": "uniq", "classification": "READ", "summary": "Collapse repeated lines." },
    { "name": "cut", "classification": "READ", "summary": "Select columns." },
    { "name": "tr", "classification": "READ", "summary": "Translate characters." },
    { "name": "ls", "classification": "READ", "summary": "Directory listing." },
    { "name": "stat", "classification": "READ", "summary": "File metadata." },
    { "name": "file", "classification": "READ", "summary": "File type identification." },
    { "name": "readlink", "classification": "READ", "summary": "Resolve a symlink." },
    { "name": "realpath", "classification": "READ", "summary": "Canonicalise a path." },
    { "name": "basename", "classification": "READ", "summary": "Strip a path to its filename." },
    { "name": "dirname", "classification": "READ", "summary": "Strip a path to its directory." },
    { "name": "echo", "classification": "READ", "summary": "Print text. Useful for probing shell state." },
    {
      "name": "find",
      "classification": "READ",
      "summary": "Locate files by name, size, or age.",
      "write_flags": ["-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprintf", "-fls"],
      "note": "-exec and -delete turn find into an arbitrary-mutation tool."
    },
    { "name": "mount", "classification": "WRITE", "bare_classification": "READ", "summary": "With no arguments it lists mounts; with arguments it mounts. Prefer findmnt." },
    { "name": "efibootmgr", "classification": "WRITE", "bare_classification": "READ", "summary": "EFI boot entries. Listing is a read; anything else rewrites NVRAM.", "read_flags": ["-v", "--verbose"], "write_flags": ["-c", "--create", "-B", "--delete-bootnum", "-b", "--bootnum", "-o", "--bootorder", "-n", "--bootnext", "-a", "--active", "-A", "--inactive", "-d", "--disk", "-t", "--timeout"] },

    { "name": "dd", "classification": "WRITE", "summary": "Block-level copy. Catastrophic when misaimed; always a proposal." },
    { "name": "rm", "classification": "WRITE", "summary": "Delete files." },
    { "name": "mv", "classification": "WRITE", "summary": "Move or rename files." },
    { "name": "cp", "classification": "WRITE", "summary": "Copy files." },
    { "name": "ln", "classification": "WRITE", "summary": "Create links." },
    { "name": "mkdir", "classification": "WRITE", "summary": "Create directories." },
    { "name": "touch", "classification": "WRITE", "summary": "Create files or update timestamps." },
    { "name": "truncate", "classification": "WRITE", "summary": "Resize files in place." },
    { "name": "chmod", "classification": "WRITE", "summary": "Change permissions." },
    { "name": "chown", "classification": "WRITE", "summary": "Change ownership." },
    { "name": "chattr", "classification": "WRITE", "summary": "Change filesystem attributes." },
    { "name": "tee", "classification": "WRITE", "summary": "Write stdin to a file." },
    { "name": "sed", "classification": "WRITE", "summary": "Stream editor. -i edits in place and the w command writes files." },
    { "name": "awk", "classification": "WRITE", "summary": "Can redirect to files from inside the program text." },
    { "name": "xargs", "classification": "WRITE", "summary": "Executes an arbitrary command per input line." },
    { "name": "fsck", "classification": "WRITE", "requires_sudo": true, "summary": "Filesystem repair. Mutates on-disk structures." },
    { "name": "e2fsck", "classification": "WRITE", "requires_sudo": true, "summary": "ext filesystem repair." },
    { "name": "xfs_repair", "classification": "WRITE", "requires_sudo": true, "summary": "XFS repair." },
    { "name": "mkfs", "classification": "WRITE", "requires_sudo": true, "summary": "Creates a filesystem — destroys everything on the device." },
    { "name": "mkswap", "classification": "WRITE", "requires_sudo": true, "summary": "Formats a swap area." },
    { "name": "swapon", "classification": "WRITE", "requires_sudo": true, "summary": "Enables swap." },
    { "name": "swapoff", "classification": "WRITE", "requires_sudo": true, "summary": "Disables swap." },
    { "name": "umount", "classification": "WRITE", "requires_sudo": true, "summary": "Unmounts a filesystem." },
    { "name": "fstrim", "classification": "WRITE", "requires_sudo": true, "summary": "Discards unused blocks." },
    { "name": "modprobe", "classification": "WRITE", "requires_sudo": true, "summary": "Loads or unloads kernel modules." },
    { "name": "reboot", "classification": "WRITE", "requires_sudo": true, "summary": "Restarts the machine." },
    { "name": "shutdown", "classification": "WRITE", "requires_sudo": true, "summary": "Powers the machine down." },
    { "name": "grub-install", "classification": "WRITE", "requires_sudo": true, "summary": "Rewrites the bootloader." },
    { "name": "grub-mkconfig", "classification": "WRITE", "requires_sudo": true, "summary": "Regenerates the GRUB config." },
    { "name": "update-grub", "classification": "WRITE", "requires_sudo": true, "summary": "Regenerates the GRUB config." },
    { "name": "dracut", "classification": "WRITE", "requires_sudo": true, "summary": "Rebuilds the initramfs." },
    { "name": "mkinitcpio", "classification": "WRITE", "requires_sudo": true, "summary": "Rebuilds the initramfs." },
    { "name": "update-initramfs", "classification": "WRITE", "requires_sudo": true, "summary": "Rebuilds the initramfs." },
    { "name": "useradd", "classification": "WRITE", "requires_sudo": true, "summary": "Creates a user." },
    { "name": "usermod", "classification": "WRITE", "requires_sudo": true, "summary": "Modifies a user." },
    { "name": "passwd", "classification": "WRITE", "requires_sudo": true, "summary": "Changes a password." },
    { "name": "bash", "classification": "WRITE", "summary": "Arbitrary code execution." },
    { "name": "sh", "classification": "WRITE", "summary": "Arbitrary code execution." },
    { "name": "python", "classification": "WRITE", "summary": "Arbitrary code execution." },
    { "name": "python3", "classification": "WRITE", "summary": "Arbitrary code execution." },
    { "name": "perl", "classification": "WRITE", "summary": "Arbitrary code execution." },
    { "name": "curl", "classification": "WRITE", "summary": "Network fetch; can write files and POST data." },
    { "name": "wget", "classification": "WRITE", "summary": "Network fetch; writes files by default." }
  ]
}
